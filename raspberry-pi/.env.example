# =====================================================================
# Raspberry Pi 에이전트 환경 변수 예시
# 복사: cp .env.example .env && chmod 600 .env
# 실제 토큰은 .env 에만 기록하세요. (.env 는 git 제외 대상)
# =====================================================================

# 클라우드 API 주소 (https 필수, 로컬 개발 시에만 http://127.0.0.1:8787 허용)
LIBRARY_API_BASE_URL=https://library-seat-api.example.workers.dev
# 비워두면 API 주소로부터 wss://.../api/ws?role=device 를 자동 생성
LIBRARY_WS_URL=

# 장치 인증 (Workers의 DEVICE_TOKEN secret 과 같은 값, 여기에는 비워둠)
LIBRARY_DEVICE_ID=library-server
LIBRARY_DEVICE_TOKEN=

# Arduino 시리얼
SERIAL_PORT=/dev/ttyACM0
SERIAL_BAUDRATE=115200
SERIAL_RECONNECT_SECONDS=5

# 동작 주기
HEARTBEAT_SECONDS=10
SEAT_SYNC_SECONDS=60
SEAT_STALE_SECONDS=120
REQUEST_TIMEOUT_SECONDS=5

# 로그
LOG_DIR=/home/pi/library-project/raspberry-pi/logs
LOG_LEVEL=INFO

# 서보모터: 현재 단계에서는 반드시 false (true 로 설정하면 에이전트가 시작되지 않음)
SERVO_ENABLED=false

# 이 장치가 담당하는 열람실 (라즈베리파이 = A, 아두이노 = B / C 예정)
DEVICE_ROOM=A

# 열람실 LCD (I2C 16x2). 주소는 /usr/sbin/i2cdetect -y 1 로 확인
# LCD_TYPE: grove-rgb = Seeed Grove LCD RGB Backlight v4 (텍스트 0x3E, 백라이트 0x62) / pcf8574 = 일반 I2C 백팩
LCD_ENABLED=false
LCD_TYPE=grove-rgb
LCD_I2C_BUS=1
LCD_I2C_ADDRESS=0x3E
LCD_RGB_ADDRESS=0x62
# 백라이트 색상 R,G,B (grove-rgb 전용): 평상시 / Offline
LCD_COLOR_NORMAL=0,255,0
LCD_COLOR_OFFLINE=255,0,0
LCD_WELCOME_SECONDS=2
LCD_ERASE_STEP_SECONDS=0.15

# 경기대 중앙/금화도서관 공석 중계 (라즈베리파이 한 대만 true). 최소 30초
CENTRAL_LIBRARY_RELAY=false
CENTRAL_LIBRARY_INTERVAL_SECONDS=60
