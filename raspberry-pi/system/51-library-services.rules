// /etc/polkit-1/rules.d/51-library-services.rules
// 사용자 pi 가 도서관 서비스 2개(library-agent, library-ble)만 sudo 없이 시작·중지·재시작할 수 있게 한다.
// 용도: 코드 업데이트 후 재시작, 아두이노 펌웨어 업로드 중 시리얼 포트 비우기.
// 다른 서비스, 활성화/비활성화(enable/disable), 설정 변경은 허용하지 않는다.
// 설치: sudo install -m 644 system/51-library-services.rules /etc/polkit-1/rules.d/
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" || subject.user !== "pi") {
        return;
    }
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    var units = ["library-agent.service", "library-ble.service"];
    var verbs = ["start", "stop", "restart"];
    if (units.indexOf(unit) >= 0 && verbs.indexOf(verb) >= 0) {
        return polkit.Result.YES;
    }
});
