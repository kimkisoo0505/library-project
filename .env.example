# =====================================================================
# 도서관 좌석 관리 시스템 - 루트 환경 변수 예시
# 이 파일을 복사해 .env 로 만들고 실제 값은 .env 에만 기록하세요.
# .env 는 .gitignore 로 제외됩니다. 이 파일에 실제 토큰/비밀번호를 쓰지 마세요.
# =====================================================================

# ---- Cloudflare (로컬 CLI용, 배포 시에만 필요) ----
# wrangler login 을 사용하는 경우 비워둡니다.
CLOUDFLARE_ACCOUNT_ID=
# API 토큰은 최소 권한으로 발급하고 절대 커밋하지 마세요.
CLOUDFLARE_API_TOKEN=

# ---- 웹 키오스크 (Vite, VITE_ 접두사만 브라우저에 노출됨) ----
# 비워두면 개발 서버 프록시(/api -> http://127.0.0.1:8787)를 사용합니다.
VITE_API_BASE=
VITE_WS_URL=

# ---- Workers 비밀 값 (wrangler secret put 으로 등록, 여기에 값 기록 금지) ----
# DEVICE_TOKEN : 라즈베리파이 에이전트 인증 토큰
#   등록: cd cloudflare && npx wrangler secret put DEVICE_TOKEN
#   로컬: cloudflare/.dev.vars 파일에 DEVICE_TOKEN=... (gitignore 대상)

# 라즈베리파이 에이전트 설정은 raspberry-pi/.env.example 을 참고하세요.
