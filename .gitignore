# ===== 비밀 정보 =====
.env
.env.*
!.env.example
# 키오스크 운영 빌드용 공개 API 주소 (비밀 아님)
!web/kiosk/.env.production
!web/kiosk/.env.development
*.pem
*.key
# 예외: 공개 중간 인증서 (개인 키 아님). 이 폴더에는 공개 인증서만 둔다
!raspberry-pi/agent/certs/*.pem
.dev.vars
.dev.vars.*
secrets/
cloudflare/wrangler.toml
cloudflare/wrangler.jsonc

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# ===== Node / 프론트엔드 =====
node_modules/
dist/
.vite/
npm-debug.log*

# ===== Cloudflare =====
.wrangler/

# ===== Arduino =====
arduino/**/build/

# ===== 로그 =====
logs/
*.log

